# nff-diagnosis — DEV image.
# Single-stage editable install (with the [dev] extras). docker-compose.dev.yml
# bind-mounts ./nff_diagnosis over /app/nff_diagnosis; `pip install -e .` imports
# from that live path, so edit-on-host + `docker compose restart nff-diagnosis`
# applies changes with no rebuild.
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY nff_diagnosis/ nff_diagnosis/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[dev]"

ENV PATH="/usr/local/bin:$PATH" \
    NFF_STORE_ROOT=/data/store \
    NFF_DB_PATH=/data/crashes.db

EXPOSE 8080

ENTRYPOINT ["nff-diag", "server", "start", "--host", "0.0.0.0", "--port", "8080"]
