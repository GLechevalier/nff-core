# nff-fleet — DEV image.
# Single-stage editable install. docker-compose.dev.yml bind-mounts ./nff_fleet
# over /app/nff_fleet, and `pip install -e .` makes Python import the package from
# that live path — so you edit on the host and just `docker compose restart nff-fleet`
# (the embedded broker/MCP loop has no hot-reload) to pick up the change. No rebuild.

# Source the Xtensa toolchain so nff_fleet.crash can symbolicate L2 (QEMU) crash backtraces
# with addr2line on ingest. ESP-IDF v5.3.1 ships the unified `xtensa-esp-elf-*` toolchain — the
# one that built the L2 firmware ELF, so its addr2line reads it. The toolchain tree is
# self-contained (bin + bundled libs under lib/).
FROM espressif/idf:v5.3.1 AS xtensa

FROM python:3.12-slim

WORKDIR /app

COPY --from=xtensa /opt/esp/tools/xtensa-esp-elf /opt/esp/tools/xtensa-esp-elf
ENV PATH="/opt/esp/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/bin:/usr/local/bin:$PATH"

COPY pyproject.toml README.md ./
COPY nff_fleet/ nff_fleet/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

EXPOSE 8883 3001

ENTRYPOINT ["nff-fleet", "start"]
