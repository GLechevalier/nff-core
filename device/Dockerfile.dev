# nff-mock — DEV image.
# Single-stage editable install. docker-compose.dev.yml bind-mounts ./nff_mock over
# /app/nff_mock and `pip install -e .` imports from that live path — edit on the host
# and `docker compose restart <mock-service>` to pick it up. No rebuild.
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY nff_mock/ nff_mock/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

ENTRYPOINT ["nff-mock", "run"]
