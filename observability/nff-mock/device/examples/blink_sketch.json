{
  "version": "1.1.0",
  "heartbeat_extra": { "led": "off" },
  "telemetry_extra": { "sensor_temp": { "random_walk": [18, 26] } },
  "commands": {
    "set_led": {
      "sets_state": "led",
      "response": { "type": "led_ack" }
    },
    "blink": {
      "response": { "type": "blinked", "times": 3 }
    }
  }
}
