# Dev image: editable install + live source bind-mount (see docker-compose.dev.yml).
# Build context is the nff-mock/ ROOT so the shared core (../core) is in scope. The
# controller stays at /app/nff_mock_controller (the live bind-mount target); core is
# installed editable from /core.
ARG DOCKER_CLI_IMAGE=docker:27-cli
FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM python:3.12-slim
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

COPY core/ /core/
WORKDIR /app
COPY controller/pyproject.toml controller/README.md ./
COPY controller/nff_mock_controller/ nff_mock_controller/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e /core && \
    pip install --no-cache-dir -e .

ENTRYPOINT ["nff-mock-controller"]
