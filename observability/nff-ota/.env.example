OTA_SUPABASE_URL=https://your-project.supabase.co
OTA_SUPABASE_KEY=your-service-role-key
OTA_ARTIFACT_BUCKET=artifacts
OTA_LOG_LEVEL=INFO

# MCP server (streamable-http transport)
OTA_MCP_HOST=0.0.0.0
OTA_MCP_PORT=3002
OTA_DEFAULT_MAX_DEVICES_IN_FLIGHT=10
OTA_DEFAULT_MAX_RETRIES=3
OTA_TRUSTED_SIGNING_KEY_PATH=

# nff-fleet command-delivery plane (fleet signs + delivers OTA commands over MQTT)
OTA_FLEET_URL=http://localhost:3001
OTA_FLEET_SECRET=change-me-in-production
OTA_FLEET_TIMEOUT=120

# nff-github server-side build plane — REQUIRED for L2 (nff-qemu-esp32) self-heal, which
# compiles the submitted firmware source for real via nff-github /internal/compile-source.
# Without OTA_GITHUB_URL an L2 break/heal fails: "OTA_GITHUB_URL is not configured".
# OTA_GITHUB_SECRET must equal nff-github's NFF_GITHUB_INTERNAL_SECRET.
OTA_GITHUB_URL=http://localhost:3003
OTA_GITHUB_SECRET=change-me-in-production
OTA_GITHUB_TIMEOUT=1800
