# The mock image build context is the nff-mock/ root (so core/ + the per-level device
# package are both visible). Keep that context lean — only source needs to ship.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/*.egg-info/
**/.venv/
**/.env
**/.env.*
# Sibling packages not needed by the device images.
controller/
targets/
# Local ESP-IDF build artifacts under qemu/l2/project (127 MB of build/ output). The L2 image
# never builds firmware from these — seed_baseline.sh compiles in a SEPARATE container — so they
# only bloat the context and, over a large transfer, can trip Docker Desktop's buildkit session.
**/build/
**/managed_components/
**/dependencies.lock
**/sdkconfig.old
