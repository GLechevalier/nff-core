# nff-pentester — "full" image with the external binaries the tools wrap.
# Use this on a host that actually runs scans (e.g. a Raspberry Pi on the IoT
# LAN). The slim Dockerfile in this dir is the minimal app-only image; this one
# adds nmap / binwalk / coap-client / strings so every tool works.
#
# Multi-arch: python:3.12-slim has an arm64 variant, so this builds natively on
# a 64-bit Pi / Ubuntu-on-Pi.

FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml README.md ./
COPY nff_pentester/ nff_pentester/

RUN python -m venv /venv && \
    /venv/bin/pip install --upgrade pip && \
    /venv/bin/pip install . && \
    /venv/bin/pip install binwalk        # extract_firmware; not in pyproject

FROM python:3.12-slim

WORKDIR /app

# External binaries the tools shell out to:
#   nmap          -> port_scan, discover_devices
#   libcoap2-bin  -> coap_discover (provides coap-client)
#   binutils      -> analyze_strings, scan_hardcoded_creds (provides `strings`)
#   bluez/dbus    -> ble_scan (bleak talks to BlueZ over DBus)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nmap libcoap2-bin binutils bluez dbus && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /venv /venv
COPY nff_pentester/ nff_pentester/

ENV PATH="/venv/bin:$PATH"
ENV PENTESTER_MCP_HOST=0.0.0.0

EXPOSE 3006
ENTRYPOINT ["nff-pentester"]
