# nff-mock-controller — on-demand mock spawner (env prefix NFF_MOCKCTL_).

# ── Docker driver ─────────────────────────────────────────────────────────────
# "" = local daemon (dev fallback). In compose this points at the controller's OWN
# scoped socket-proxy so it can only create/start/remove containers.
NFF_MOCKCTL_DOCKER_HOST=tcp://mock-docker-socket-proxy:2375
# NFF_MOCKCTL_DOCKER_PATH=docker
# NFF_MOCKCTL_DOCKER_TIMEOUT=60

# ── What we spawn ───────────────────────────────────────────────────────────────
NFF_MOCKCTL_MOCK_IMAGE=nff-mock:dev
# The RESOLVED docker network name the mock joins (give the compose network `name:`).
NFF_MOCKCTL_MOCK_NETWORK=nff
# Named volume with provisioned certs + cmd-sign key, mounted :ro into each mock.
NFF_MOCKCTL_FLEET_DATA_VOLUME=nff-dev_fleet-data-dev
# NFF_MOCKCTL_BROKER_HOST=nff-fleet
# NFF_MOCKCTL_BROKER_PORT=8883
# NFF_MOCKCTL_MOCK_MEM=128m
# NFF_MOCKCTL_MOCK_CPUS=0.25
# NFF_MOCKCTL_MOCK_PIDS=128

# ── Fleet provisioning plane ─────────────────────────────────────────────────────
NFF_MOCKCTL_FLEET_URL=http://nff-fleet:3001
# Must equal nff-fleet's NFF_FLEET_MCP_SECRET.
NFF_MOCKCTL_FLEET_SECRET=dev-fleet-secret
# NFF_MOCKCTL_FLEET_TIMEOUT=30

# ── Controller API (this service) ────────────────────────────────────────────────
# Gates POST/GET/DELETE /mocks via the X-Control-Secret header.
NFF_MOCKCTL_CONTROL_SECRET=dev-fleet-secret
# NFF_MOCKCTL_HTTP_HOST=0.0.0.0
# NFF_MOCKCTL_HTTP_PORT=3004

# ── Lifecycle limits ──────────────────────────────────────────────────────────────
# NFF_MOCKCTL_MOCK_TTL_S=1800
# NFF_MOCKCTL_REAPER_INTERVAL_S=60
# NFF_MOCKCTL_MAX_PER_PROJECT=3
# NFF_MOCKCTL_MAX_TOTAL=50

# NFF_MOCKCTL_LOG_LEVEL=INFO
