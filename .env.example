# nff-fleet environment variables
# Copy to .env and fill in real values

# Ports
NFF_FLEET_MQTT_PORT=8883
NFF_FLEET_MCP_PORT=3000

# Data root — all persistent state lives under this path
NFF_FLEET_DATA_DIR=/data

# TLS (server-side for MQTT broker)
NFF_FLEET_TLS_CA_CERT=/data/certs/ca.crt
NFF_FLEET_TLS_SERVER_CERT=/data/certs/server.crt
NFF_FLEET_TLS_SERVER_KEY=/data/certs/server.key

# ECDSA P-256 command signing key
NFF_FLEET_CMD_SIGN_KEY=/data/keys/cmd_sign.pem

# Command timeout (seconds)
NFF_FLEET_COMMAND_TIMEOUT=30.0

# Presence reaper — a device is marked offline after HEARTBEAT_TIMEOUT seconds
# of silence; the reaper sweeps for stale devices every REAPER_INTERVAL seconds.
NFF_FLEET_HEARTBEAT_TIMEOUT=90.0
NFF_FLEET_REAPER_INTERVAL=30.0

# Audit log
NFF_FLEET_AUDIT_LOG=/data/audit/commands.jsonl

# Shared secret: MCP session bearer token AND the X-Fleet-Secret header on
# POST /internal/command. nff-ota authenticates to fleet with this — set
# OTA_FLEET_SECRET to the same value.
NFF_FLEET_MCP_SECRET=change-me-in-production

# Supabase — optional. If unset, all persistence is disabled.
# NFF_FLEET_SUPABASE_URL=https://<project-ref>.supabase.co
# NFF_FLEET_SUPABASE_KEY=<service_role_key>
