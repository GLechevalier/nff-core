# nff-pentester environment variables
# Copy to .env and adjust as needed.

# Timeout for external tool invocations (nmap, binwalk, etc.)
PENTESTER_TOOL_TIMEOUT_SECONDS=120

# Safety caps for brute-force modules
PENTESTER_MAX_BRUTE_THREADS=4
PENTESTER_MAX_BRUTE_ATTEMPTS=200

# Default service ports
PENTESTER_SSH_PORT=22
PENTESTER_TELNET_PORT=23
PENTESTER_MQTT_PORT=1883
PENTESTER_MQTT_TLS_PORT=8883
PENTESTER_COAP_PORT=5683

# HTTP client timeout for web tests
PENTESTER_HTTP_TIMEOUT_SECONDS=10.0

# Logging level: DEBUG | INFO | WARNING | ERROR
PENTESTER_LOG_LEVEL=INFO

# Developer mode: registers extra dev-only tools (e.g. render_vuln_tree, the
# vulnerability-tree visualizer). Leave off for normal/production use.
PENTESTER_DEV_MODE=false

# MCP transport. Serves streamable-HTTP at http://<host>:<port>/mcp by default,
# matching the sibling nff servers. Bind to loopback locally; the container
# image overrides the host to 0.0.0.0. Set transport to 'stdio' for local
# single-process use.
PENTESTER_MCP_HOST=127.0.0.1
PENTESTER_MCP_PORT=3006
PENTESTER_MCP_TRANSPORT=streamable-http
