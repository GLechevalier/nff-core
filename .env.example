# nff-pentester environment variables
# Copy to .env and adjust as needed.

# Timeout for external tool invocations (nmap, binwalk, etc.)
PENTESTER_TOOL_TIMEOUT_SECONDS=120

# Safety caps for brute-force modules
PENTESTER_MAX_BRUTE_THREADS=4
PENTESTER_MAX_BRUTE_ATTEMPTS=200

# Default service ports
PENTESTER_SSH_PORT=22
PENTESTER_TELNET_PORT=23
PENTESTER_MQTT_PORT=1883
PENTESTER_MQTT_TLS_PORT=8883
PENTESTER_COAP_PORT=5683

# HTTP client timeout for web tests
PENTESTER_HTTP_TIMEOUT_SECONDS=10.0

# Logging level: DEBUG | INFO | WARNING | ERROR
PENTESTER_LOG_LEVEL=INFO
